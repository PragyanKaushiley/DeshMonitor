# Development artifacts
.dev-artifacts/
screenshots/
test-output/
debug-output/
generated/

# Local reports / exports
reports/
exports/

# One-time DB seed inputs — never committed, deleted by their seed script after use
apps/ingest/src/domains/news/sources.seed.json
apps/ingest/src/domains/weather/locations.seed.json

