  },
  "dependencies": {
    "@desh-monitor/config": "workspace:*",
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.38.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
