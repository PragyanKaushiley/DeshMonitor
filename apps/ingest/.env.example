# Copy to .env.local for local development — `pnpm ingest` loads this
# file automatically (main.ts, via Node's process.loadEnvFile). Never
# commit the real values (see .gitignore and CLAUDE.md §9). In GitHub
# Actions this is set as the DATABASE_URL repo secret instead of a file.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=verify-full
