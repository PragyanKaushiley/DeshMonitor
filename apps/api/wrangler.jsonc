{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/index.ts",
  "name": "desh-monitor-api",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Production values; `wrangler dev` overrides WEB_APP_ORIGIN from .dev.vars.
  // Secrets (DATABASE_URL, UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN,
  // GITHUB_TOKEN) are set with `wrangler secret put`, never committed.
  "vars": {
    "WEB_APP_ORIGIN": "https://deshmonitor.com",
    "GITHUB_REPO": "PragyanKaushiley/DeshMonitor"
  },
  // Served at api.deshmonitor.com: the same site as the web app, so the API's
  // SameSite=Lax cookies (visitor id, login session) work from it.
  "routes": [{ "pattern": "api.deshmonitor.com", "custom_domain": true }],
  // Only the custom domain: no *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // Every 15 minutes (:05, :20, :35, :50 UTC) — src/scheduled.ts picks the
  // ingest jobs due at each slot.
  "triggers": {
    "crons": ["5,20,35,50 * * * *"]
  }
}
