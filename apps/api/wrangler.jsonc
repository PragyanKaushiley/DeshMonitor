{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/index.ts",
  "name": "desh-monitor-api",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Production values; `wrangler dev` overrides WEB_APP_ORIGIN from .dev.vars.
  // Secrets (DATABASE_URL, UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN,
  // GITHUB_TOKEN) are set with `wrangler secret put`, never committed.
  "vars": {
    "WEB_APP_ORIGIN": "https://deshmonitor.com",
    "GITHUB_REPO": "PragyanKaushiley/DeshMonitor"
  },
  // Every 15 minutes (:05, :20, :35, :50 UTC) — src/scheduled.ts picks the
  // ingest jobs due at each slot.
  "triggers": {
    "crons": ["5,20,35,50 * * * *"]
  }
}
