    "@desh-monitor/redis": "workspace:*",
    "hono": "^4.13.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@desh-monitor/config": "workspace:*",
    "drizzle-orm": "^0.38.4",
    "vitest": "^2.1.8",
    "wrangler": "4.85.0"
  }
