{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "desh-monitor-web",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The site, on the apex and www (www is redirected to the apex by a
  // Cloudflare redirect rule). Only these custom domains: no *.workers.dev
  // or preview URLs. The API URL is baked in at build time:
  // NEXT_PUBLIC_API_URL=https://api.deshmonitor.com.
  "routes": [
    { "pattern": "deshmonitor.com", "custom_domain": true },
    { "pattern": "www.deshmonitor.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "desh-monitor-web"
    }
  ]
}
